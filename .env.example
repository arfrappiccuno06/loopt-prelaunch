# Supabase — client-side (anon) credentials.
# Must be EXPO_PUBLIC_ prefixed: Expo inlines these at BUILD time.
# Copy this file to .env.local and fill in real values from your Supabase
# project (Settings → API). Add the SAME two vars in Vercel project settings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
